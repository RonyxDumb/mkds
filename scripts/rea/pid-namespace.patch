new file mode 100644
index 0000000..49e32f3
--- /dev/null
+++ b/bridge/process/linux_proc_namespace.py
@@ -0,0 +1,36 @@
+"""Resolve local PIDs to procfs PIDs using kernel pidfds, never guessed offsets."""
+import errno
+import json
+import os
+
+def ids(status, field):
+    return list(map(int, next(line.split(':', 1)[1] for line in status.splitlines() if line.startswith(field + ':')).split()))
+
+self_status = open('/proc/self/status').read()
+depth = len(ids(self_status, 'NSpid')) - 1
+assert ids(self_status, 'NSpid')[depth] == os.getpid()
+result = []
+for outer in os.listdir('/proc'):
+    if not outer.isdigit():
+        continue
+    try:
+        status = open('/proc/' + outer + '/status').read()
+        candidates = ids(status, 'NSpid')
+        if len(candidates) <= depth:
+            continue
+        local = candidates[depth]
+        fd = os.pidfd_open(local, 0)
+        try:
+            info = open('/proc/self/fdinfo/' + str(fd)).read()
+            # The kernel fd binds the local PID to exactly one live task.
+            if ids(info, 'Pid') != [int(outer)]:
+                continue
+            if ids(info, 'NSpid') != candidates:
+                continue
+            result.append({'outer': outer, 'pid': local})
+        finally:
+            os.close(fd)
+    except OSError as error:
+        if error.errno not in (errno.ENOENT, errno.ESRCH):
+            raise
+print(json.dumps(result))
